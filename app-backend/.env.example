# --- Aplicacion ---
APP_NAME="Ventas Forecast API"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
# Colorea los logs de consola (ANSI). Se ven tal cual en `docker compose logs`.
# Poner en false para logs planos (CI, ficheros, agregadores de logs).
LOG_COLORS=true
# Echo de cada sentencia SQL a consola (muy verboso). Apagado por defecto para
# no sepultar la narrativa del pipeline de prediccion; ponlo en true para depurar
# consultas. Para ver los "prints" de datos/features del modelo usa LOG_LEVEL=DEBUG.
DB_ECHO=false

# --- Base de datos (Postgres 17) ---
# Formato: postgresql+asyncpg://usuario:password@host:puerto/nombre_bd
# Puerto 5434 en el host (mapeado por docker-compose) para no chocar con otros
# Postgres locales en el 5432/5433. Dentro de docker-compose, el backend usa
# "db:5432" internamente (ver la variable DATABASE_URL override en docker-compose.yml).
DATABASE_URL=postgresql+asyncpg://ventas_user:ventas_password@localhost:5434/ventas_forecast
POSTGRES_USER=ventas_user
POSTGRES_PASSWORD=ventas_password
POSTGRES_DB=ventas_forecast

# --- JWT ---
JWT_SECRET_KEY=change-this-to-a-random-64-char-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (lista separada por comas) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=5/minute

# --- Modelo ML ---
MODEL_ARTIFACTS_DIR=artifacts

# --- Seguridad ---
MAX_BODY_SIZE_BYTES=2000000

# --- Admin inicial (usado por scripts/create_admin.py) ---
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-this-password

# --- LLM (resumen ejecutivo de los reportes PDF, opcional) ---
# Si se deja vacio, el reporte usa un resumen generado por plantilla (sin LLM).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Reportes PDF ---
# Ruta a un logo (PNG/SVG) para la cabecera del PDF. Si se deja vacio o el
# archivo no existe, el reporte usa el nombre de la app como marca en texto.
REPORT_LOGO_PATH=
REPORT_CURRENCY_SYMBOL=$
